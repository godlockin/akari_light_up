# .claudeignore - Exclude files from Claude context

# Build outputs
dist/
build/
out/
target/
scripts/rust_solver/target/
scripts/rust_solver/target_local/
scripts/rust_solver/pkg/

# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
Cargo.lock

# Cache
.cache/
*.tsbuildinfo
.eslintcache
.stylelintcache

# Environment files
.env
.env.*

# Large files / Binary
*.pdf
*.zip
*.tar.gz
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.woff
*.woff2
*.ttf
*.eot

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Coverage
coverage/

# Cloudflare Wrangler
.wrangler/

# Temporary/One-time scripts
validate_puzzles.ts
filter_valid_puzzles.ts
VALIDATION_REPORT.md